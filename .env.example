# Public URL where this server is reachable (used in QR codes and Twilio signature checks)
BASE_URL=https://returns.example.com
PORT=3000

# Twilio credentials (https://console.twilio.com). Leave empty to run in DRY_RUN mode (SMS are only logged).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use EITHER a Messaging Service (recommended, required for A2P 10DLC) OR a sending number in E.164 format.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Employees who receive the alerts: "Name:+1XXXXXXXXXX" separated by commas
EMPLOYEES=Ana:+13055550101,Luis:+13055550102,Carlos:+13055550103

# Language of the SMS sent to employees: es | en
SMS_LANG=es
# Time zone used to print times in SMS
TZ=America/New_York

# Re-send a reminder if nobody claims the vehicle after N minutes (0 = disabled), up to MAX_REMINDERS times
REMINDER_MINUTES=10
MAX_REMINDERS=2

# Ignore a repeated scan of the same plate at the same location within N minutes
DEDUPE_MINUTES=15

# Token to read the alert list at GET /api/alerts (header: Authorization: Bearer <token>)
ADMIN_TOKEN=change-me

# Set to false only for local testing of the inbound webhook without a valid Twilio signature
TWILIO_VALIDATE_WEBHOOK=true
